<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Administrator: issue the separate return approval PIN of a POS Manager employee (generated by the server) -->
    <record id="urp_approval_pin_wizard_view_form" model="ir.ui.view">
        <field name="name">urp.approval.pin.wizard.form</field>
        <field name="model">urp.approval.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Approval PIN">
                <div class="alert alert-info" role="alert">
                    This PIN is only used to approve returns outside the return policy in the Point of Sale.
                    The server generates it (8 digits, different from every POS login PIN), shows it to you once,
                    stores it only as a salted hash and never sends it to the POS devices.
                    Issuing a new PIN revokes the previous one.
                </div>
                <group>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="has_pin" string="A PIN is already set"/>
                </group>
                <footer>
                    <button name="action_set" string="Issue PIN" type="object" class="btn-primary"
                            confirm="Issue a new return approval PIN for this employee? Any previous PIN stops working."/>
                    <button name="action_clear" string="Remove PIN" type="object" invisible="not has_pin"
                            confirm="Remove the return approval PIN of this employee?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_urp_approval_pin_wizard" model="ir.actions.act_window">
        <field name="name">Return Approval PIN</field>
        <field name="res_model">urp.approval.pin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_urp_approval_pin" name="Return Approval PINs" parent="point_of_sale.menu_point_config_product"
              action="action_urp_approval_pin_wizard" groups="point_of_sale.group_pos_manager" sequence="90"/>

    <!-- POS Manager employee: approve a ship-later request (returned from Inventory) with the approval PIN -->
    <record id="urp_exception_pin_wizard_view_form" model="ir.ui.view">
        <field name="name">urp.exception.pin.wizard.form</field>
        <field name="model">urp.exception.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="POS Manager approval">
                <field name="verified" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="not error">
                    <field name="error" readonly="1"/>
                </div>
                <group>
                    <field name="exception_id"/>
                    <field name="pin" password="True" placeholder="POS Manager approval PIN"/>
                </group>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="urp_return_exception_view_form_pin" model="ir.ui.view">
        <field name="name">urp.return.exception.form.pin</field>
        <field name="model">urp.return.exception</field>
        <field name="inherit_id" ref="unified_product_return_policy.urp_return_exception_view_form"/>
        <field name="arch" type="xml">
            <button name="action_reject" position="after">
                <field name="can_approve_with_pin" invisible="1"/>
                <button name="action_urp_approve_with_pin" string="Approve with Manager PIN" type="object"
                        invisible="not can_approve_with_pin"/>
            </button>
            <field name="approved_by" position="after">
                <field name="approved_by_employee_id" invisible="not approved_by_employee_id"/>
            </field>
        </field>
    </record>

    <!-- audit: who approved, as what, how the identity was verified, who executed -->
    <record id="urp_return_override_view_form_identity" model="ir.ui.view">
        <field name="name">urp.return.override.form.identity</field>
        <field name="model">urp.return.override</field>
        <field name="inherit_id" ref="unified_product_return_policy.urp_return_override_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="approver_role"/>
                <field name="auth_method"/>
                <field name="approver_employee_id" invisible="not approver_employee_id"/>
                <field name="approver_config_id" invisible="not approver_config_id"/>
                <field name="executed_by_user_id" invisible="not pos_order_id"/>
                <field name="executed_by_employee_id" invisible="not executed_by_employee_id"/>
                <field name="same_person"/>
            </field>
        </field>
    </record>
    <record id="urp_return_override_view_list_identity" model="ir.ui.view">
        <field name="name">urp.return.override.list.identity</field>
        <field name="model">urp.return.override</field>
        <field name="inherit_id" ref="unified_product_return_policy.urp_return_override_view_list"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="approver_employee_id" optional="show"/>
                <field name="approver_role" optional="show"/>
                <field name="auth_method" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
