<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_urp_portal" model="ir.ui.view">
        <field name="name">sale.order.form.urp.portal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="urp_portal_requests" string="Portal Return Requests" invisible="not urp_request_ids">
                    <field name="urp_request_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="submitted_at"/>
                            <field name="return_reason_id"/>
                            <field name="state"/>
                            <button name="action_cancel_remaining" type="object" string="Cancel remaining"
                                    invisible="state != 'active'" groups="sales_team.group_sale_salesman"
                                    confirm="Release the quantities not yet received? The customer will not get a new return period."/>
                        </list>
                        <form>
                            <group>
                                <field name="submitted_at"/>
                                <field name="state"/>
                                <field name="return_reason_id"/>
                            </group>
                            <field name="line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="move_id"/>
                                    <field name="requested_qty"/>
                                    <field name="processed_qty"/>
                                    <field name="cancelled_qty"/>
                                    <field name="open_qty"/>
                                </list>
                            </field>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
