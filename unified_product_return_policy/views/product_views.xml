<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_urp" model="ir.ui.view">
        <field name="name">product.template.form.urp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <field name="urp_policy_visible" invisible="1"/>
                <group name="urp_return_policy" string="Return Policy" invisible="not urp_policy_visible">
                    <field name="use_custom_return_period"/>
                    <field name="custom_return_period_days" readonly="not use_custom_return_period"
                           help="Set 0 to make this product non-returnable."/>
                    <field name="urp_non_returnable" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="status" invisible="not urp_policy_visible or not urp_non_returnable">
                    Non-Returnable – Returns are not allowed for this product.
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_category_form_view_urp" model="ir.ui.view">
        <field name="name">product.category.form.urp</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <field name="urp_policy_visible" invisible="1"/>
                <group name="urp_return_policy" string="Return Policy" invisible="not urp_policy_visible">
                    <field name="use_custom_return_period"/>
                    <field name="custom_return_period_days" readonly="not use_custom_return_period"
                           help="Set 0 to make products in this category non-returnable unless overridden at product level."/>
                    <field name="urp_non_returnable" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="status" invisible="not urp_policy_visible or not urp_non_returnable">
                    Non-Returnable – Returns are not allowed for the products of this category, unless overridden at product level.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
