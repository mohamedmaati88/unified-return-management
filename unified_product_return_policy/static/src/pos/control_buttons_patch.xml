<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="unified_product_return_policy.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <t t-if="this.urpHasRefundLines">
                <t t-call="point_of_sale.controlButton"
                   icon="'admin_panel_settings'"
                   btnText.translate="Return Override"
                   btnClasses="'btn-secondary '"
                   onClick="() => this.clickUrpOverride()"/>
            </t>
        </xpath>
    </t>
</templates>
